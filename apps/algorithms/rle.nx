fn rle(s)
    if len(s) == 0
        return ""
    out = ""
    prev = s[0]
    cnt = 1
    i = 1
    while i < len(s)
        if s[i] == prev
            cnt += 1
        else
            out = out + prev + str(cnt)
            prev = s[i]
            cnt = 1
        i += 1
    return out + prev + str(cnt)

print "rle(aaabbbcccd) = {rle(\"aaabbbcccd\")}"
print "rle(wwwwaaadexxxxxx) = {rle(\"wwwwaaadexxxxxx\")}"
