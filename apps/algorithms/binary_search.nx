fn bsearch(a, target)
    lo = 0
    hi = len(a) - 1
    while lo <= hi
        mid = floor((lo + hi) / 2)
        if a[mid] == target
            return mid
        elif a[mid] < target
            lo = mid + 1
        else
            hi = mid - 1
    return -1

arr = [1, 3, 5, 7, 9, 11, 13, 15]
print "index of 7: {bsearch(arr, 7)}"
print "index of 8: {bsearch(arr, 8)}"
print "index of 15: {bsearch(arr, 15)}"
