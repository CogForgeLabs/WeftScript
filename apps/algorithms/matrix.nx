fn matmul(a, b, n)
    result = [[0 for j in range(n)] for i in range(n)]
    for i in range(n)
        for j in range(n)
            col = [b[k][j] for k in range(n)]
            result[i][j] = vdot(a[i], col)
    return result

a = [[1, 2], [3, 4]]
b = [[5, 6], [7, 8]]
print "Matrix multiply (SIMD vdot per cell):"
print matmul(a, b, 2)
