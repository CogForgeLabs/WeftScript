fn collatz_len(n)
    steps = 0
    while n != 1
        if n % 2 == 0
            n = n / 2
        else
            n = 3 * n + 1
        steps += 1
    return steps

print "Collatz sequence lengths for 1..10:"
print [collatz_len(i) for i in range(1, 11)]
print "Longest under 30: n={0}"
best = 1
best_len = 0
for n in range(1, 30)
    l = collatz_len(n)
    if l > best_len
        best_len = l
        best = n
print "  n={best} length={best_len}"
